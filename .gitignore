# Weights and everything derived from them at full size: never in git.
# Fetch the model from the Hub (see README) and regenerate the rest.
models/
cells/
*.safetensors
*.cub
*.grid
# v3: tensors fetched by byte range, admitted once against v1's seals (v3-based/t10/fetch.py re-fetches them)
v3-based/t10/*.u16
# v3: t6's exported closed set (v3-based/walk/export_t6.py regenerates it)
v3-based/walk/*.bin

# Build outputs and dependencies
**/target/
node_modules/
__pycache__/
*.pyc

# The v2 walk store (regenerated by `npm run walk`; the sealed receipts in v2-retry/mm/receipts stay)
v2-retry/mm/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Per-table dumps (regenerated by v2-retry/mm/src/tables-*.ts); the model-wide summaries and LUTs stay
v2-retry/tables/qwen3-1.7b/
v2-retry/tables/**/model/
*.cube

# Local-only settings
.claude/settings.local.json
